#Ejemplo de variables de entorno para el backend de MediSense
#Rellena estos valores en tu entorno de producción/desarrollo.
#Base de datos (URL completa, p.ej. postgres://user:pass@host:port/dbname)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASS>@<DB_HOST>:<DB_PORT>/<DB_NAME>

#Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

#URL del frontend para CORS / redirects en desarrollo
FRONTEND_DEV_URL=http://localhost:3000

#APIs externas (marcar como requeridas si la app las usa)
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here